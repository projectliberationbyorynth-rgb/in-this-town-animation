
import React from 'react';
import {ThreeCanvas} from '@remotion/three';
import {useCurrentFrame, useVideoConfig} from 'remotion';
import * as THREE from 'three';

const Box = ({
  position,
  size,
  color,
}: {
  position: [number, number, number];
  size: [number, number, number];
  color: string;
}) => (
  <mesh position={position}>
    <boxGeometry args={size}/>
    <meshStandardMaterial color={color}/>
  </mesh>
);

const TownScene: React.FC = () => {
  const frame = useCurrentFrame();
  const t = frame / 30;
  const walk = Math.sin(t * 9) * 0.25;
  const x = -2 + t * 0.8;

  const camera = React.useMemo(() => {
    const cam = new THREE.PerspectiveCamera(
      40,
      16 / 9,
      0.1,
      100
    );
    return cam;
  }, []);

  camera.position.set(
    5 - t * 0.25,
    4,
    10
  );
  camera.lookAt(0, 1.3, 0);

  return (
    <>
      <primitive object={camera} makeDefault/>

      <ambientLight intensity={1.6}/>
      <directionalLight
        position={[5, 10, 6]}
        intensity={2}
      />

      {/* Ground and road */}
      <Box
        position={[0, -0.16, 0]}
        size={[24, 0.3, 20]}
        color="#77b981"
      />
      <Box
        position={[0, 0.01, 0]}
        size={[24, 0.06, 3.8]}
        color="#505768"
      />

      {/* Colorful buildings */}
      {[-7, -4, -1, 2, 5, 8].map((bx, i) => (
        <group key={i}>
          <Box
            position={[bx, 1.7, -5]}
            size={[2.4, 3.4, 2.5]}
            color={
              ['#eeb2a0', '#b9b2ec',
               '#f3d28e', '#9fd7cb'][i % 4]
            }
          />
          <Box
            position={[bx, 3.55, -5]}
            size={[2.7, 0.35, 2.8]}
            color="#795b70"
          />
          <Box
            position={[bx, 2, -3.73]}
            size={[0.8, 0.9, 0.08]}
            color="#b7eaff"
          />
        </group>
      ))}

      {/* Leo */}
      <group position={[x, 0, 0]}>
        {/* Legs */}
        <group position={[-0.17, 0.62, 0]}
          rotation={[walk, 0, 0]}>
          <Box
            position={[0, -0.3, 0]}
            size={[0.19, 0.65, 0.2]}
            color="#283d63"
          />
        </group>
        <group position={[0.17, 0.62, 0]}
          rotation={[-walk, 0, 0]}>
          <Box
            position={[0, -0.3, 0]}
            size={[0.19, 0.65, 0.2]}
            color="#283d63"
          />
        </group>

        {/* Body */}
        <Box
          position={[0, 1.15, 0]}
          size={[0.65, 0.85, 0.35]}
          color="#3179c6"
        />

        {/* Arms */}
        <Box
          position={[-0.46, 1.1, 0]}
          size={[0.2, 0.75, 0.2]}
          color="#ffd2ad"
        />
        <Box
          position={[0.46, 1.1, 0]}
          size={[0.2, 0.75, 0.2]}
          color="#ffd2ad"
        />

        {/* Head */}
        <mesh position={[0, 1.94, 0]}>
          <sphereGeometry args={[0.45, 24, 24]}/>
          <meshStandardMaterial color="#ffd8b7"/>
        </mesh>

        {/* Signature hair */}
        <Box
          position={[-0.22, 2.34, 0]}
          size={[0.44, 0.23, 0.65]}
          color="#f04458"
        />
        <Box
          position={[0.22, 2.34, 0]}
          size={[0.44, 0.23, 0.65]}
          color="#22c77a"
        />

        {/* Eyes */}
        <Box
          position={[-0.16, 2, 0.4]}
          size={[0.08, 0.1, 0.04]}
          color="#172236"
        />
        <Box
          position={[0.16, 2, 0.4]}
          size={[0.08, 0.1, 0.04]}
          color="#172236"
        />
      </group>
    </>
  );
};

export const Town3DTest: React.FC = () => {
  const {width, height} = useVideoConfig();

  return (
    <div style={{
      width: '100%',
      height: '100%',
      background: '#b5ddf2'
    }}>
      <ThreeCanvas
        width={width}
        height={height}
      >
        <TownScene/>
      </ThreeCanvas>

      <div style={{
        position: 'absolute',
        top: '13%',
        left: '38%',
        color: '#ffffff',
        background: '#1e293b',
        borderRadius: 16,
        padding: '12px 28px',
        fontSize: 58,
        fontWeight: 900,
        fontFamily: 'Arial, sans-serif'
      }}>
        $0
      </div>
    </div>
  );
};
